{
	"id":"photonProj_micro",
	"specClass":"missile",
	"missileType":"ROCKET",
	#"missileType":"MISSILE_TWO_STAGE_SECOND_UNGUIDED",
	"sprite":"graphics/torpedoes/photon_torp.png",
	"size":[64,64],	
	"center":[32,32],
	"collisionRadius":15,
	"collisionClass":"MISSILE_FF",
	"explosionColor":[255,155,100,255],  # purely visual, will get a white additively blended core on top of this color
	"explosionRadius":250, # purely visual
	"explosionSpec":{"duration":0.1f, # not visual
					 "radius":125,
					 "coreRadius":75, # full damage within core radius
					 "collisionClass":"PROJECTILE_FF",
					 "collisionClassByFighter":"PROJECTILE_FIGHTER",	
					 "particleSizeMin":5.0,
					 "particleSizeRange":3.0,
					 "particleDuration":1,
					 "particleCount":150,
					 "particleColor":[255,185,155,255]},
	"armingTime":0.5,
	"engineSpec":{"turnAcc":1250,
				  "turnRate":175,
				  "acc":1500,
				  "dec":500},
	"engineSlots":[{"id":"ES1",
					"loc":[0,0],
				    #"style":"TORPEDO_ATROPOS",
				    "style":"CUSTOM",
					"styleSpec":{
						"mode":"QUAD_STRIP", # PARTICLES or QUAD_STRIP, determines which params are used
						"engineColor":[207,177,107,100],
						"glowSizeMult":2.0,
						"glowAlternateColor":[194,240,216,100],
						"contrailDuration":5,
						"contrailWidthMult":5,
						"contrailWidthAddedFractionAtEnd":2,  # can be negative. makes trail spread out/narrow at the end
						"contrailMinSeg":5, # min segment length, in pixels
						"contrailMaxSpeedMult":.0f,
						"contrailAngularVelocityMult":0.5f,
						"contrailSpawnDistMult":.5, # how far away from engine it starts
						"contrailColor":[207,177,107,100],
						"type":"GLOW" # GLOW or SMOKE; additive or regular blend mode
					},
				    "width":5.0,
				    "length":5.0,
				    "angle":0.0}]
}